{
  "name": "ng-jvx-multiselect-workspace",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n server,demo -c magenta,cyan \"npm:start:server\" \"npm:start:demo\"",
    "start:server": "node --watch projects/mock-server/server.js",
    "start:demo": "nx serve demo-sandbox --port 4300 --ssl true",
    "build": "nx build ng-jvx-multiselect --watch",
    "build-prod": "nx build ng-jvx-multiselect --configuration production",
    "publish": "npm run build-prod && npm publish ./dist/ng-jvx-multiselect",
    "test": "nx test",
    "lint": "nx lint",
    "e2e": "nx e2e",
    "build-lib-watch-styles": "scss-bundle -e \"./projects/ng-jvx-multiselect/src/lib/ng-jvx-multiselect.component.scss\" -o \"./dist/ng-jvx-multiselect/ng-jvx-multiselect.scss\" -p \"./\" -w true --rootDir \"./projects/ng-jvx-multiselect/src/lib\"",
    "build-lib-prod-styles": "scss-bundle -e \"./projects/ng-jvx-multiselect/src/lib/ng-jvx-multiselect.component.scss\" -o \"./dist/ng-jvx-multiselect/ng-jvx-multiselect.scss\" -p \"./\""
  },
  "dependencies": {
    "@angular/animations": "~22.2.0",
    "@angular/cdk": "~22.2.0",
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/platform-browser-dynamic": "~22.2.0",
    "@angular/router": "~22.2.0",
    "form-data": "^4.0.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~22.2.0",
    "@angular-devkit/core": "~22.2.0",
    "@angular-devkit/schematics": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@nx/angular": "24.0.5",
    "@nx/devkit": "24.0.5",
    "@nx/eslint": "24.0.5",
    "@nx/eslint-plugin": "24.0.5",
    "@nx/js": "24.0.5",
    "@nx/playwright": "24.0.5",
    "@nx/workspace": "24.0.5",
    "@playwright/test": "^1.64.1",
    "@schematics/angular": "~22.2.0",
    "@types/jasmine": "~5.1.9",
    "@types/node": "^24.3.0",
    "angular-eslint": "22.6.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^1.6.2",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "5.9.0",
    "jsonc-eslint-parser": "^3.3.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "ng-packagr": "~22.2.0",
    "nx": "24.0.5",
    "scss-bundle": "^3.1.2",
    "ts-node": "~10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
