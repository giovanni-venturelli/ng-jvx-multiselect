{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "types": [
      "jasmine"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": [
      "dom",
      "es2022"
    ],
    "isolatedModules": true
