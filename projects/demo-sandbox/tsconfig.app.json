{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/app",
    "types": [],
    "paths": {
      "ng-jvx-multiselect": [
        "../ng-jvx-multiselect/src"
      ]
    },
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": [
      "dom",
      "es2022"
    ]
  },
  "files": [
    "src/main.ts",
    "src/polyfills.ts"
  ],
  "include": [
    "src/**/*.d.ts"
  ],
  "angularCompilerOptions": {
    "strictTemplates": false
  }
}
